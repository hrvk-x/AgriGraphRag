NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# Optional: leave empty to print retrieved evidence without LLM generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embedding model name (downloaded automatically on first run).
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Optional: set to a local snapshot path to skip downloading.
# EMBEDDING_MODEL_PATH=/path/to/local/model

# Optional: override the default ChromaDB and triples paths.
# CHROMA_DIR=./chroma_db
# TRIPLES_JSON=../agri_kg_production/output/triples.json
